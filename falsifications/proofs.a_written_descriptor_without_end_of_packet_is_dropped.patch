Falsifies `e1000e::proofs::a_written_descriptor_without_end_of_packet_is_dropped`.

The defect: the receive verdict forgets end-of-packet, so the first buffer of a frame that spans
buffers is delivered as if it were the whole frame.

Expected to fail: the harness's `assert!(receive_verdict(word, room) == ReceiveVerdict::Drop)`, on
any written word without end-of-packet, with no error bit and a length that fits.

diff --git a/src/descriptor.rs b/src/descriptor.rs
--- a/src/descriptor.rs
+++ b/src/descriptor.rs
@@ -104,7 +104,7 @@ pub fn receive_verdict(word: u64, room: usize) -> ReceiveVerdict {
     let len = (word & 0xffff) as usize;
     let fits =
         (14..=MAXIMUM_FRAME_BYTES).contains(&len) && len <= room && len as u64 <= BUFFER_BYTES;
-    if status & RECEIVE_STATUS_END_OF_PACKET == 0 || errors & RECEIVE_FRAME_ERROR_MASK != 0 || !fits
+    if errors & RECEIVE_FRAME_ERROR_MASK != 0 || !fits
     {
         return ReceiveVerdict::Drop;
     }
